{
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "redirects": [
    {
      "source": "/services",
      "destination": "/was-ich-baue",
      "type": 301
    },
    {
      "source": "/services.html",
      "destination": "/was-ich-baue",
      "type": 301
    },
    {
      "source": "/en/services",
      "destination": "/en/what-i-build",
      "type": 301
    },
    {
      "source": "/de",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/de/:path+",
      "destination": "/:path+",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "_nuxt/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "fonts/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "img/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "readme/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/was-ich-baue",
      "destination": "/was-ich-baue/index.html"
    },
    {
      "source": "/en/what-i-build",
      "destination": "/en/what-i-build/index.html"
    },
    {
      "source": "/readme/:page([a-z]+)",
      "destination": "/readme/:page.svg"
    }
  ]
}
